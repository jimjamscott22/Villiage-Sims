    <mxCell id="stage3" value="3. Needs Decay &amp; Utility AI&#10;Decay hunger/energy/social, score actions, hysteresis gating" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="260" width="400" height="60" as="geometry" />
    </mxCell>

    <!-- Stage 4: Movement & Jobs -->
    <mxCell id="stage4" value="4. Movement &amp; Economy Execution&#10;A* pathfinding, job board matching (haul, produce, tend, gather)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="350" width="400" height="60" as="geometry" />
    </mxCell>

    <!-- Stage 5: Population & Chronicle -->
    <mxCell id="stage5" value="5. Progression &amp; Chronicle Update&#10;Housing check for births, starvation deaths, log events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="440" width="400" height="60" as="geometry" />
    </mxCell>

    <!-- Stage 6: Viewport Culling & Snapshot Serialization -->
    <mxCell id="stage6" value="6. Viewport Culling &amp; Snapshot Broadcast&#10;Filter entities in camera margin, emit TickSnapshot to watch channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="530" width="400" height="60" as="geometry" />
    </mxCell>

    <!-- Stage 7: Client Render Loop -->
    <mxCell id="stage7" value="7. Client Interpolation &amp; RAF Render&#10;Interpolate last 2 snapshots by alpha, draw stacked HTML5 Canvas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="620" width="400" height="60" as="geometry" />
    </mxCell>

    <!-- Connections -->
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="stage1" target="stage2" />
